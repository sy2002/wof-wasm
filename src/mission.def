/* The registry of the original's tables (SPEC 7.2), beside src/globals.def.
 *
 * globals.def holds the plain globals; this file holds what is a table of records: the
 * tables that sit at a fixed address in the DATA hunk, and the tables the original
 * allocates per mission or once at start-up.  The entries become the members of
 * wof_mission_t (src/wof.h), which lives inside the core's state, and tests/shim.c reads
 * the same list so that the harness can copy a table between the original's memory and
 * the port with the record layouts of src/records.def.
 *
 *   WOF_TABLE(name, rec, count, addr)       `count` records of wof_<rec>_t at `addr` in DATA
 *   WOF_POOL(name, rec, capacity, pointer)  an allocation: the original keeps a pointer to
 *                                           it at `pointer`; the port keeps up to
 *                                           `capacity` records at a fixed place, zeroed
 *                                           when the original allocates (MEMF_CLEAR)
 *
 * Where the memory lives, and why a pool has the capacity it has, is in
 * re/notes/porting-m4.md ("Where mission memory lives"); tests/test_mission.py holds each
 * capacity against the fifteen maps.
 */

/* ------------------------------------------------------------- at fixed addresses in DATA */

WOF_TABLE(object_records,      object,   15, 0x024CAE)
WOF_TABLE(object_record_extra, object,    1, 0x025594)
/* crash_object: the record 0x0146C6 makes up for a crash on land (x and type 0). */
WOF_TABLE(crash_object,        object,    1, 0x027700)
WOF_TABLE(player,              player,    1, 0x025078)
WOF_TABLE(aircraft_records,    aircraft,  4, 0x02522A)
WOF_TABLE(airfield_records,    airfield,  4, 0x0252FA)
WOF_TABLE(ship_records,        ship,      5, 0x025460)
WOF_TABLE(view_caches,         cache,     2, 0x027F30)

/* The five ship blocks at 0x025096 (0x40 bytes each: a count at +0 and entries of eight
 * bytes from +8) and the drawing's copy of them, which snapshot_for_draw takes with 80
 * moves of a long in every pass. */
WOF_TABLE(ship_blocks,         word,    160, 0x025096)
WOF_TABLE(ship_blocks_draw,    word,    160, 0x024F38)

/* Shape pointers.  0x01D1EA fills the three frame tables of the enemy aircraft at the
 * mission's start: japplane_shapes and eighth-scale by name, 28 facing each way, and three
 * variants of each in the dashboard's map window. */
WOF_TABLE(japplane_frames,     shaperef,    56, 0x026F8E)
WOF_TABLE(eighth_frames,       shaperef,    56, 0x02706E)
WOF_TABLE(dash_frames,         shaperef,   168, 0x02745C)
WOF_TABLE(torpedo_shape,       shaperef,     1, 0x02541E)
WOF_TABLE(g_02541a,            shaperef,     1, 0x02541A)

/* The sound engine (M8, re/notes/sound.md): the eight slots, two per channel; the four
 * channels' records; and the pointers sounds_load keeps to the eight effects, by file. */
WOF_TABLE(sound_slots,         sound_slot,    8, 0x027368)
WOF_TABLE(sound_channels,      sound_channel, 4, 0x027E6E)
WOF_TABLE(sound_boom,          soundptr,  1, 0x026E3E)
WOF_TABLE(sound_clang,         soundptr,  1, 0x026E42)
WOF_TABLE(sound_engine,        soundptr,  1, 0x026E58)
WOF_TABLE(sound_grind,         soundptr,  1, 0x026E7A)
WOF_TABLE(sound_machinegun,    soundptr,  1, 0x026E96)
WOF_TABLE(sound_screech,       soundptr,  1, 0x026EA8)
WOF_TABLE(sound_scream,        soundptr,  1, 0x026EAC)
WOF_TABLE(sound_splash,        soundptr,  1, 0x026EB4)

/* The music's segments (M8 part 2): music_start keeps the song data's segment list and its
 * address, the player's segment list and its entry. */
WOF_TABLE(songs_seglist,       segptr,    1, 0x027428)
WOF_TABLE(song_data,           segptr,    1, 0x02742C)
WOF_TABLE(player_seglist,      segptr,    1, 0x0255EA)
WOF_TABLE(player_entry,        segptr,    1, 0x0255EE)

/* The music's own memory (M8 part 2, re/notes/music.md): the parts of the player's DATA
 * hunk that change, found in the original through the player's segment list (hunk 1), and
 * the voices of the song data, found through song_data at +0xCC. */
WOF_POOL(player_head,          plhead,    1, 0x0255EA)
WOF_POOL(player_vars,          plvars,    1, 0x0255EA)
WOF_POOL(player_tracks,        track,     4, 0x0255EA)
WOF_POOL(player_song,          plsong,    1, 0x0255EA)
WOF_POOL(song_voices,          voice,     7, 0x02742C)

/* A pointer into the map's record list: the last record. */
WOF_TABLE(map_records_end,     mapptr,    1, 0x02462C)

/* ------------------------------------------------------------------------ allocations */

/* The map's record list: `length` bytes from map_load, of which the last eight come from
 * no file and stay zero; map_scan's second walk reads one record past the list.  The
 * longest map, m, is 7,138 bytes. */
WOF_POOL(map_records,          word,   3576, 0x024628)

/* map_scan's tables, by the counts it takes in its first walk.  The largest over the
 * fifteen maps: 14 slot-4 targets and 13 slot-3 targets (map m, 135 soldiers), 30
 * slot-0x0F targets (map o). */
WOF_POOL(target_records_4,     gtarget,   16, 0x0254F8)
WOF_POOL(target_records_3,     gtarget,   16, 0x0254FC)
WOF_POOL(soldier_records,      soldier, 160, 0x025500)
WOF_POOL(target_records_f,     gtarget_f, 32, 0x025504)

/* The gun lists of the four enemy ships, sub_01350e (ship +0x06). */
WOF_POOL(guns_destroyer,       gun,      16, 0x025466)
WOF_POOL(guns_battleship,      gun,      16, 0x025484)
WOF_POOL(guns_cruiseship,      gun,      16, 0x0254A2)
WOF_POOL(guns_japcarrier,      gun,      16, 0x0254C0)

/* The demo (M7 part 2, re/notes/demo.md): rank_select's buffer of 0x1388 bytes for a
 * recording, or the file wofdemo as load_file reads it for a playback; demo_buffer_set
 * (src/wof.h, wof_front_t) is the port's pointer. */
WOF_POOL(demo_buffer,          byte,   0x1388, 0x026D4E)

/* The four pools and the two master lists of alloc_pools, allocated once at start-up. */
WOF_POOL(ricochet_records,     splash,   20, 0x026EA4)
WOF_POOL(splash_records,       splash,   20, 0x026F30)
WOF_POOL(smoke_records,        smoke,    40, 0x026F58)
WOF_POOL(balloon_records,      balloon,  20, 0x026F66)
WOF_POOL(master_list,          shaperef,   278, 0x026F54)
WOF_POOL(ath_list,             shaperef,   278, 0x026F82)
