/* The layouts of the original's records (SPEC 7.2).
 *
 * Every record the port keeps is described here once, field by field, with the offset and
 * the width the original uses.  src/wof.h turns each description into a C struct with the
 * fields in the original order; tests/shim.c turns the same description into a table that
 * the harness uses to copy a record between the original's big-endian bytes and the
 * port's struct.  A field's name is its role where the listing shows it and its offset
 * where it does not yet (w1c is the word at +0x1C); later milestones rename as they learn.
 *
 *   WOF_RECORD(rec, size)                        begin record type wof_<rec>_t, the original's size
 *   WOF_FIELD(rec, name, ctype, offset, kind)    one field
 *   WOF_FIELD_ARRAY(rec, name, ctype, n, offset, kind)
 *   WOF_RECORD_END(rec)
 *
 * Kinds say how a field travels between the two representations:
 *   WOF_K_PLAIN  an integer of the same width on both sides, big-endian in the original
 *   WOF_K_SHAPE  a pointer to a shape record in the original (4 bytes), a shape handle in
 *                the port (uint16_t, wof_shape_handle), 0 on both sides for none
 *   WOF_K_MAP    a pointer into the map's record list in the original (4 bytes), a byte
 *                offset into wof_m.map_records in the port (uint32_t)
 *   WOF_K_POOL   a pointer to an allocation in the original (4 bytes); the port keeps the
 *                allocation at a fixed place in its state and this field only says whether
 *                there is one (uint16_t, 0 or 1)
 *   WOF_K_SOUND  a pointer into one of the eight sound effects in the original (4 bytes), a
 *                sound handle in the port (uint32_t, WOF_SOUND: the file's index in
 *                sound_files plus one in the top byte, the offset into the file below it),
 *                0 on both sides for none
 *   WOF_K_SONG   a pointer into the song data, wofsongs's DATA hunk, in the original (4 bytes),
 *                the offset into that hunk in the port (uint32_t), 0 on both sides for none
 *   WOF_K_VECTOR a level-4 interrupt vector in the original (4 bytes), in the port the handler
 *                it names (uint32_t, WOF_L4_*), 0 on both sides for none
 *
 * The fields of a record tile it exactly; tests/test_mission.py holds every record to that.
 */

/* ------------------------------------------------------------------ one object, 0x2A
 * object_records (0x024CAE, fifteen) and object_record_extra (0x025594), re/notes/objects.md.
 * +0x08 to +0x0D is what snapshot_for_draw copies for the drawing: the position and the
 * kind byte with the byte after it. */
WOF_RECORD(object, 0x2A)
WOF_FIELD(object, x,          int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(object, w02,        int16_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(object, y,          int16_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(object, w06,        int16_t,  0x06, WOF_K_PLAIN)
WOF_FIELD(object, draw_x,     int16_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(object, draw_y,     int16_t,  0x0A, WOF_K_PLAIN)
WOF_FIELD(object, draw_kind,  uint8_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(object, draw_b0d,   uint8_t,  0x0D, WOF_K_PLAIN)
WOF_FIELD(object, speed_x,    int16_t,  0x0E, WOF_K_PLAIN)
WOF_FIELD(object, w10,        int16_t,  0x10, WOF_K_PLAIN)
WOF_FIELD(object, l12,        int32_t,  0x12, WOF_K_PLAIN)
WOF_FIELD(object, w16,        int16_t,  0x16, WOF_K_PLAIN)
WOF_FIELD(object, w18,        int16_t,  0x18, WOF_K_PLAIN)
WOF_FIELD(object, w1a,        int16_t,  0x1A, WOF_K_PLAIN)
WOF_FIELD(object, w1c,        int16_t,  0x1C, WOF_K_PLAIN)
WOF_FIELD(object, frame,      uint8_t,  0x1E, WOF_K_PLAIN)
WOF_FIELD(object, b1f,        int8_t,   0x1F, WOF_K_PLAIN)
WOF_FIELD(object, kind,       uint8_t,  0x20, WOF_K_PLAIN)
WOF_FIELD(object, b21,        uint8_t,  0x21, WOF_K_PLAIN)
WOF_FIELD(object, type,       int16_t,  0x22, WOF_K_PLAIN)
WOF_FIELD(object, w24,        int16_t,  0x24, WOF_K_PLAIN)
WOF_FIELD(object, w26,        int16_t,  0x26, WOF_K_PLAIN)
WOF_FIELD(object, w28,        int16_t,  0x28, WOF_K_PLAIN)
WOF_RECORD_END(object)

/* ------------------------------------------------------------ the player, 0x1E at 0x025078
 * The record player_record (0x027DEC) points at.  It ends at +0x1E: what follows at
 * 0x025096 are the five ship blocks, which snapshot_for_draw copies as a whole. */
WOF_RECORD(player, 0x1E)
WOF_FIELD(player, y,          int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(player, x,          int16_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(player, shape,      uint16_t, 0x04, WOF_K_SHAPE)
WOF_FIELD(player, frame_name, uint32_t, 0x08, WOF_K_PLAIN)
WOF_FIELD(player, on_deck,    int16_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(player, fuel,       int16_t,  0x0E, WOF_K_PLAIN)
WOF_FIELD(player, w10,        int16_t,  0x10, WOF_K_PLAIN)
WOF_FIELD(player, oil,        int16_t,  0x12, WOF_K_PLAIN)
WOF_FIELD(player, facing,     int16_t,  0x14, WOF_K_PLAIN)
WOF_FIELD(player, speed_x,    int16_t,  0x16, WOF_K_PLAIN)
WOF_FIELD(player, speed_y,    int16_t,  0x18, WOF_K_PLAIN)
WOF_FIELD(player, w1a,        int16_t,  0x1A, WOF_K_PLAIN)
WOF_FIELD(player, enemy_countdown, int16_t, 0x1C, WOF_K_PLAIN)
WOF_RECORD_END(player)

/* ---------------------------------------------------------- an enemy aircraft, 0x34
 * aircraft_records (0x02522A, four), re/notes/enemy.md: the fields by their writers.  +0x00
 * is the state (0 free, 1 unused, 2 flying, 4 shot down and falling, 8 unused, 0x10
 * burning on the water); +0x02 the kind and manoeuvre (1 a fighter cruising, 2 a fighter on
 * the player's tail, 4 a torpedo plane, 0x10 a torpedo plane that has dropped, bit 3 in a
 * turn); +0x04 where it is against the player (1 behind him the same way, 3 ahead of him
 * the same way, 2 and 4 the other way, east and west of him). */
WOF_RECORD(aircraft, 0x34)
WOF_FIELD(aircraft, state,       int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(aircraft, mode,        int16_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(aircraft, relation,    int16_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(aircraft, hit,         int16_t,  0x06, WOF_K_PLAIN)
WOF_FIELD(aircraft, health,      int16_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(aircraft, burst,       int16_t,  0x0A, WOF_K_PLAIN)
WOF_FIELD(aircraft, order,       int16_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(aircraft, w0e,         int16_t,  0x0E, WOF_K_PLAIN)
WOF_FIELD(aircraft, timer,       int16_t,  0x10, WOF_K_PLAIN)
WOF_FIELD(aircraft, firing,      int16_t,  0x12, WOF_K_PLAIN)
WOF_FIELD(aircraft, facing,      int16_t,  0x14, WOF_K_PLAIN)
WOF_FIELD(aircraft, attitude,    int16_t,  0x16, WOF_K_PLAIN)
WOF_FIELD(aircraft, turn_in,     int16_t,  0x18, WOF_K_PLAIN)
WOF_FIELD(aircraft, turns,       int16_t,  0x1A, WOF_K_PLAIN)
WOF_FIELD(aircraft, speed,       int16_t,  0x1C, WOF_K_PLAIN)
WOF_FIELD(aircraft, want_speed,  int16_t,  0x1E, WOF_K_PLAIN)
WOF_FIELD(aircraft, x,           int16_t,  0x20, WOF_K_PLAIN)
WOF_FIELD(aircraft, climb,       int16_t,  0x22, WOF_K_PLAIN)
WOF_FIELD(aircraft, want_y,      int16_t,  0x24, WOF_K_PLAIN)
WOF_FIELD(aircraft, y,           int16_t,  0x26, WOF_K_PLAIN)
WOF_FIELD(aircraft, distance,    int16_t,  0x28, WOF_K_PLAIN)
WOF_FIELD(aircraft, w2a,         int16_t,  0x2A, WOF_K_PLAIN)
WOF_FIELD(aircraft, flash,       int16_t,  0x2C, WOF_K_PLAIN)
WOF_FIELD(aircraft, draw_x,      int16_t,  0x2E, WOF_K_PLAIN)
WOF_FIELD(aircraft, frame,       int16_t,  0x30, WOF_K_PLAIN)
WOF_FIELD(aircraft, step_count,  int16_t,  0x32, WOF_K_PLAIN)
WOF_RECORD_END(aircraft)

/* --------------------------------------------------------------------- a ship, 0x1E
 * ship_records (0x025460, five: destroyer, battleship, cruise ship, japanese carrier, and
 * the player's carrier at carrier_record 0x0254D8).  map_scan fills them, re/notes/map.md. */
WOF_RECORD(ship, 0x1E)
WOF_FIELD(ship, span0,        int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(ship, span1,        int16_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(ship, present,      int16_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(ship, guns,         uint16_t, 0x06, WOF_K_POOL)
WOF_FIELD(ship, gun_count,    int16_t,  0x0A, WOF_K_PLAIN)
WOF_FIELD(ship, w0c,          int16_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(ship, w0e,          int16_t,  0x0E, WOF_K_PLAIN)
WOF_FIELD(ship, w10,          int16_t,  0x10, WOF_K_PLAIN)
WOF_FIELD(ship, w12,          int16_t,  0x12, WOF_K_PLAIN)
WOF_FIELD(ship, w14,          int16_t,  0x14, WOF_K_PLAIN)
WOF_FIELD(ship, w16,          int16_t,  0x16, WOF_K_PLAIN)
WOF_FIELD(ship, w18,          int16_t,  0x18, WOF_K_PLAIN)
WOF_FIELD(ship, row,          int16_t,  0x1A, WOF_K_PLAIN)
WOF_FIELD(ship, slot_base,    int16_t,  0x1C, WOF_K_PLAIN)
WOF_RECORD_END(ship)

/* ------------------------------------------------------------ a ship's gun, 0x0E
 * The list sub_01350e allocates for a ship (ship +0x06), one entry per gun_count. */
WOF_RECORD(gun, 0x0E)
WOF_FIELD_ARRAY(gun, w, int16_t, 7, 0x00, WOF_K_PLAIN)
WOF_RECORD_END(gun)

/* ------------------------------------------------------------------ an airfield, 0x14
 * airfield_records (0x0252FA, four), filled by 0x012C84 from the markers 0x114 and 0x115;
 * snapshot_for_draw copies +0x06..+0x09 to +0x10..+0x13 for the drawing. */
WOF_RECORD(airfield, 0x14)
WOF_FIELD_ARRAY(airfield, w, int16_t, 10, 0x00, WOF_K_PLAIN)
WOF_RECORD_END(airfield)

/* ----------------------------------------------- a slot-4 or slot-3 target, 0x10
 * target_records_4 and target_records_3, re/notes/map.md. */
WOF_RECORD(gtarget, 0x10)
WOF_FIELD(gtarget, map_offset, uint32_t, 0x00, WOF_K_PLAIN)
WOF_FIELD(gtarget, x0,         int16_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(gtarget, x1,         int16_t,  0x06, WOF_K_PLAIN)
WOF_FIELD(gtarget, state,      uint8_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(gtarget, island,     uint8_t,  0x09, WOF_K_PLAIN)
WOF_FIELD(gtarget, w0a,        int16_t,  0x0A, WOF_K_PLAIN)
WOF_FIELD(gtarget, w0c,        int16_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(gtarget, w0e,        int16_t,  0x0E, WOF_K_PLAIN)
WOF_RECORD_END(gtarget)

/* --------------------------------------------------------- a slot-0x0F target, 0x0E */
WOF_RECORD(gtarget_f, 0x0E)
WOF_FIELD(gtarget_f, map_offset, int16_t, 0x00, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, w02,      int16_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, w04,      int16_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, island,   int16_t,  0x06, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, state,    uint8_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, b09,      uint8_t,  0x09, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, w0a,      int16_t,  0x0A, WOF_K_PLAIN)
WOF_FIELD(gtarget_f, w0c,      int16_t,  0x0C, WOF_K_PLAIN)
WOF_RECORD_END(gtarget_f)

/* ------------------------------------------------------------------- a soldier, 8 */
WOF_RECORD(soldier, 0x08)
WOF_FIELD(soldier, x,         int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(soldier, dir,       int8_t,   0x02, WOF_K_PLAIN)
WOF_FIELD(soldier, frame,     uint8_t,  0x03, WOF_K_PLAIN)
WOF_FIELD(soldier, timer,     int8_t,   0x04, WOF_K_PLAIN)
WOF_FIELD(soldier, island,    uint8_t,  0x05, WOF_K_PLAIN)
WOF_FIELD(soldier, state,     int16_t,  0x06, WOF_K_PLAIN)
WOF_RECORD_END(soldier)

/* ------------------------------------------------------------- the four pools of alloc_pools
 * Positions and velocities of Smoke and Balloons are 16.16 longs; code that addresses
 * the word at +0x00 or +0x04 is addressing the whole part (re/notes/objects.md). */
WOF_RECORD(smoke, 0x14)
WOF_FIELD(smoke, x,           int32_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(smoke, y,           int32_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(smoke, dx,          int32_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(smoke, dy,          int32_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(smoke, kind,        int16_t,  0x10, WOF_K_PLAIN)
WOF_FIELD(smoke, timer,       int16_t,  0x12, WOF_K_PLAIN)
WOF_RECORD_END(smoke)

WOF_RECORD(splash, 0x04)
WOF_FIELD(splash, x,          int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(splash, count,      uint8_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(splash, kind,       uint8_t,  0x03, WOF_K_PLAIN)
WOF_RECORD_END(splash)

WOF_RECORD(balloon, 0x12)
WOF_FIELD(balloon, x,         int32_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(balloon, y,         int32_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(balloon, dx,        int32_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(balloon, dy,        int32_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(balloon, frame,     int8_t,   0x10, WOF_K_PLAIN)
WOF_FIELD(balloon, in_use,    uint8_t,  0x11, WOF_K_PLAIN)
WOF_RECORD_END(balloon)

/* ------------------------------------------------ the dashboard's per-buffer cache, 0x14
 * view_caches (0x027F30), one entry per view; draw_dashboard redraws an instrument only
 * when its value differs from what this buffer last showed.  sub_01ed7a invalidates an
 * entry by setting the high byte of every word, and of the score's long. */
WOF_RECORD(cache, 0x14)
WOF_FIELD(cache, oil_warn,    int16_t,  0x00, WOF_K_PLAIN)
WOF_FIELD(cache, oil,         int16_t,  0x02, WOF_K_PLAIN)
WOF_FIELD(cache, fuel_warn,   int16_t,  0x04, WOF_K_PLAIN)
WOF_FIELD(cache, fuel,        int16_t,  0x06, WOF_K_PLAIN)
WOF_FIELD(cache, weapon,      int16_t,  0x08, WOF_K_PLAIN)
WOF_FIELD(cache, weapons,     int16_t,  0x0A, WOF_K_PLAIN)
WOF_FIELD(cache, lives,       int16_t,  0x0C, WOF_K_PLAIN)
WOF_FIELD(cache, w0e,         int16_t,  0x0E, WOF_K_PLAIN)
WOF_FIELD(cache, score,       uint32_t, 0x10, WOF_K_PLAIN)
WOF_RECORD_END(cache)

/* ------------------------------------------------------- tables of one kind of value */
WOF_RECORD(word, 0x02)
WOF_FIELD(word, v,            uint16_t, 0x00, WOF_K_PLAIN)
WOF_RECORD_END(word)

WOF_RECORD(shaperef, 0x04)
WOF_FIELD(shaperef, s,           uint16_t, 0x00, WOF_K_SHAPE)
WOF_RECORD_END(shaperef)

WOF_RECORD(mapptr, 0x04)
WOF_FIELD(mapptr, off,        uint32_t, 0x00, WOF_K_MAP)
WOF_RECORD_END(mapptr)

/* ------------------------------------------------------ the sound engine (M8), re/notes/sound.md
 * A sound slot, 0x18: the eight at 0x027368, two per audio channel, the first of each pair
 * before the second.  What sub_011f76 builds and the tick switches on and off; +0x10 and
 * +0x14 of a pair's first slot are what the channel plays now, which sound_channels
 * compares with the slot it chose.  +0x0 is a word the tick tests as a whole and sets with
 * st.b, which makes 0xFF00. */
WOF_RECORD(sound_slot, 0x18)
WOF_FIELD(sound_slot, active,     uint16_t, 0x00, WOF_K_PLAIN)
WOF_FIELD(sound_slot, sample,     uint32_t, 0x02, WOF_K_SOUND)
WOF_FIELD(sound_slot, length,     uint32_t, 0x06, WOF_K_PLAIN)
WOF_FIELD(sound_slot, period,     uint16_t, 0x0A, WOF_K_PLAIN)
WOF_FIELD(sound_slot, volume,     uint16_t, 0x0C, WOF_K_PLAIN)
WOF_FIELD(sound_slot, repeat,     int16_t,  0x0E, WOF_K_PLAIN)
WOF_FIELD(sound_slot, playing,    uint32_t, 0x10, WOF_K_SOUND)
WOF_FIELD(sound_slot, playing_pv, uint32_t, 0x14, WOF_K_PLAIN)
WOF_RECORD_END(sound_slot)

/* An audio channel's record, 0x1E: the four at 0x027E6E that sub_01ea28 fills, that
 * soundfx_vblank starts from and eases, and that audio_irq counts down and frees.  +0x0 is
 * also the busy flag; +0x4 the engine's VBlank count when the channel last stopped, which
 * holds a new start back for two VBlanks; +0xE the volume as 16.16, whose upper word goes to
 * AUDxVOL; +0x16 the volume it eases to, negative for none, and +0x1A the step. */
WOF_RECORD(sound_channel, 0x1E)
WOF_FIELD(sound_channel, sample,  uint32_t, 0x00, WOF_K_SOUND)
WOF_FIELD(sound_channel, stamp,   uint32_t, 0x04, WOF_K_PLAIN)
WOF_FIELD(sound_channel, pending, uint16_t, 0x08, WOF_K_PLAIN)
WOF_FIELD(sound_channel, words,   uint16_t, 0x0A, WOF_K_PLAIN)
WOF_FIELD(sound_channel, period,  uint16_t, 0x0C, WOF_K_PLAIN)
WOF_FIELD(sound_channel, volume,  uint32_t, 0x0E, WOF_K_PLAIN)
WOF_FIELD(sound_channel, repeat,  int16_t,  0x12, WOF_K_PLAIN)
WOF_FIELD(sound_channel, count,   int16_t,  0x14, WOF_K_PLAIN)
WOF_FIELD(sound_channel, target,  int32_t,  0x16, WOF_K_PLAIN)
WOF_FIELD(sound_channel, step,    int32_t,  0x1A, WOF_K_PLAIN)
WOF_RECORD_END(sound_channel)

/* A pointer to a sound effect: sounds_load keeps one per file. */
WOF_RECORD(soundptr, 0x04)
WOF_FIELD(soundptr, p,          uint32_t, 0x00, WOF_K_SOUND)
WOF_RECORD_END(soundptr)

/* ------------------------------------------------ the music player (M8 part 2, re/notes/music.md)
 * songplay's DATA hunk, 0x3DC bytes, lies where LoadSeg put it; the port keeps its variables
 * in four parts (src/mission.def), and the constants between them - the resource's and the
 * interrupt's names, note_clocks and durations - come from re/tables.toml.  Offsets are
 * those of the hunk, 0x1000 below re/songplay.lst's addresses. */

/* +0x000: the track's channel bits, the resource, the timer's Interrupt node, the vector
 * the player found at 0x70 */
WOF_RECORD(plhead, 0x44)
WOF_FIELD(plhead, dma_on,       uint16_t, 0x00, WOF_K_PLAIN)
WOF_FIELD(plhead, dma_off,      uint16_t, 0x02, WOF_K_PLAIN)
WOF_FIELD(plhead, int_on,       uint16_t, 0x04, WOF_K_PLAIN)
WOF_FIELD(plhead, track_number, uint16_t, 0x06, WOF_K_PLAIN)
WOF_FIELD(plhead, ciaa_base,    uint16_t, 0x08, WOF_K_POOL)
WOF_FIELD_ARRAY(plhead, ciaa_name, uint8_t, 14, 0x0C, WOF_K_PLAIN)
WOF_FIELD(plhead, node_succ,    uint32_t, 0x1A, WOF_K_PLAIN)
WOF_FIELD(plhead, node_pred,    uint32_t, 0x1E, WOF_K_PLAIN)
WOF_FIELD(plhead, node_type,    uint8_t,  0x22, WOF_K_PLAIN)
WOF_FIELD(plhead, node_pri,     int8_t,   0x23, WOF_K_PLAIN)
WOF_FIELD(plhead, node_name,    uint16_t, 0x24, WOF_K_POOL)
WOF_FIELD(plhead, node_data,    uint32_t, 0x28, WOF_K_PLAIN)
WOF_FIELD(plhead, node_code,    uint16_t, 0x2C, WOF_K_POOL)
WOF_FIELD_ARRAY(plhead, timer_name, uint8_t, 16, 0x30, WOF_K_PLAIN)
WOF_FIELD(plhead, saved_level4_vector, uint32_t, 0x40, WOF_K_VECTOR)
WOF_RECORD_END(plhead)

/* +0x27C: the player's state (the file's own symbols) */
WOF_RECORD(plvars, 0x2E)
WOF_FIELD(plvars, play_state,   uint16_t, 0x00, WOF_K_PLAIN)   /* PlayState */
WOF_FIELD(plvars, track_state,  uint32_t, 0x02, WOF_K_PLAIN)   /* TrackState */
WOF_FIELD(plvars, sfx_state,    uint16_t, 0x06, WOF_K_PLAIN)   /* SfxState */
WOF_FIELD(plvars, sfx_music_vol, uint16_t, 0x08, WOF_K_PLAIN)  /* SfxMusicVol */
WOF_FIELD(plvars, song_addr,    uint32_t, 0x0A, WOF_K_SONG)    /* SongAddr */
WOF_FIELD(plvars, fade_count,   int16_t,  0x0E, WOF_K_PLAIN)   /* FadeCount */
WOF_FIELD(plvars, fade_speed,   int16_t,  0x10, WOF_K_PLAIN)   /* FadeSpeed */
WOF_FIELD(plvars, paused,       uint16_t, 0x12, WOF_K_PLAIN)   /* Paused */
WOF_FIELD(plvars, sound_ptr,    uint16_t, 0x14, WOF_K_POOL)    /* SoundPtr */
WOF_FIELD(plvars, sound_channel, uint16_t, 0x18, WOF_K_PLAIN)  /* SoundChannel */
WOF_FIELD(plvars, sound_volume, uint16_t, 0x1A, WOF_K_PLAIN)   /* SoundVolume */
WOF_FIELD(plvars, sound_count,  uint16_t, 0x1C, WOF_K_PLAIN)   /* SoundCount */
WOF_FIELD_ARRAY(plvars, track_info, uint16_t, 4, 0x1E, WOF_K_POOL) /* TrackInfo: the four tracks */
WOF_RECORD_END(plvars)

/* +0x2AA: a track, Track0Info to Track3Info.  +0x28 to +0x34 hold the addresses of the
 * channel's AUDxVOL, AUDxPER, AUDxLC and AUDxLEN, which the player writes through. */
WOF_RECORD(track, 0x4A)
WOF_FIELD(track, active,     uint16_t, 0x00, WOF_K_PLAIN)
WOF_FIELD(track, seq,        uint32_t, 0x02, WOF_K_SONG)    /* the track's sequence */
WOF_FIELD(track, pos,        uint32_t, 0x06, WOF_K_SONG)    /* the next event of its pattern */
WOF_FIELD(track, seq_index,  uint32_t, 0x0A, WOF_K_PLAIN)   /* the sequence entry's offset */
WOF_FIELD(track, dur,        uint16_t, 0x0E, WOF_K_PLAIN)   /* ticks the note has left */
WOF_FIELD(track, release,    uint16_t, 0x10, WOF_K_PLAIN)   /* the tick of its release */
WOF_FIELD(track, irq,        int16_t,  0x12, WOF_K_PLAIN)   /* 1 started, 0 off at the next, -1 done */
WOF_FIELD(track, vhdr,       uint32_t, 0x14, WOF_K_SONG)    /* the voice's VHDR */
WOF_FIELD(track, body,       uint32_t, 0x18, WOF_K_SONG)    /* and BODY */
WOF_FIELD(track, octave_div, uint16_t, 0x1C, WOF_K_PLAIN)
WOF_FIELD(track, volume,     uint16_t, 0x1E, WOF_K_PLAIN)
WOF_FIELD(track, base_period, uint16_t, 0x20, WOF_K_PLAIN)
WOF_FIELD(track, loop_words, uint16_t, 0x22, WOF_K_PLAIN)   /* the repeat part's words */
WOF_FIELD(track, loop_start, uint32_t, 0x24, WOF_K_SONG)    /* and its first byte */
WOF_FIELD(track, reg_vol,    uint32_t, 0x28, WOF_K_PLAIN)
WOF_FIELD(track, reg_per,    uint32_t, 0x2C, WOF_K_PLAIN)
WOF_FIELD(track, reg_lc,     uint32_t, 0x30, WOF_K_PLAIN)
WOF_FIELD(track, reg_len,    uint32_t, 0x34, WOF_K_PLAIN)
WOF_FIELD(track, hold,       uint16_t, 0x38, WOF_K_PLAIN)
WOF_FIELD(track, tie,        uint16_t, 0x3A, WOF_K_PLAIN)
WOF_FIELD(track, voice,      uint32_t, 0x3C, WOF_K_SONG)
WOF_FIELD(track, note,       uint16_t, 0x40, WOF_K_PLAIN)
WOF_FIELD(track, cur_period, uint16_t, 0x42, WOF_K_PLAIN)
WOF_FIELD(track, vib_step,   int16_t,  0x44, WOF_K_PLAIN)
WOF_FIELD(track, sfx,        uint16_t, 0x46, WOF_K_PLAIN)
WOF_FIELD(track, sfx_count,  int16_t,  0x48, WOF_K_PLAIN)
WOF_RECORD_END(track)

/* +0x3D2: the song _ReadInstruments chose and its voice table */
WOF_RECORD(plsong, 0x0A)
WOF_FIELD(plsong, song_ptr,    uint32_t, 0x00, WOF_K_SONG)
WOF_FIELD(plsong, voice_table, uint32_t, 0x04, WOF_K_SONG)
WOF_FIELD(plsong, w3da,        uint16_t, 0x08, WOF_K_PLAIN)
WOF_RECORD_END(plsong)

/* A voice of the song data, 0x2E bytes at 0xCC + 0x2E x n of wofsongs's DATA hunk, n 0 to
 * 6: the only part of the song data the player writes. */
WOF_RECORD(voice, 0x2E)
WOF_FIELD(voice, vhdr,       uint32_t, 0x00, WOF_K_SONG)    /* _ReadInstruments: past "VHDR" */
WOF_FIELD(voice, body,       uint32_t, 0x04, WOF_K_SONG)    /* and past "BODY" */
WOF_FIELD(voice, octave_div, uint16_t, 0x08, WOF_K_PLAIN)   /* 0x53 / ctOctave */
WOF_FIELD(voice, form,       uint32_t, 0x0A, WOF_K_SONG)    /* the sample's 8SVX FORM */
WOF_FIELD(voice, l0e,        uint32_t, 0x0E, WOF_K_PLAIN)
WOF_FIELD(voice, vib_hi,     uint16_t, 0x12, WOF_K_PLAIN)
WOF_FIELD(voice, vib_lo,     uint16_t, 0x14, WOF_K_PLAIN)
WOF_FIELD(voice, vib_step,   int16_t,  0x16, WOF_K_PLAIN)
WOF_FIELD(voice, vib_every,  uint16_t, 0x18, WOF_K_PLAIN)
WOF_FIELD(voice, vib_first,  uint16_t, 0x1A, WOF_K_PLAIN)
WOF_FIELD(voice, vib_count,  int16_t,  0x1C, WOF_K_PLAIN)
WOF_FIELD(voice, vibrato,    uint16_t, 0x1E, WOF_K_PLAIN)
WOF_FIELD(voice, w20,        uint16_t, 0x20, WOF_K_PLAIN)
WOF_FIELD(voice, arpeggio,   uint16_t, 0x22, WOF_K_PLAIN)
WOF_FIELD_ARRAY(voice, arp,  int16_t, 4, 0x24, WOF_K_PLAIN)
WOF_FIELD(voice, arp_index,  uint16_t, 0x2C, WOF_K_PLAIN)
WOF_RECORD_END(voice)

/* A pointer the game keeps to one of the music's segments or to the song data: the port
 * keeps whether it is set. */
WOF_RECORD(segptr, 0x04)
WOF_FIELD(segptr, set,        uint16_t, 0x00, WOF_K_POOL)
WOF_RECORD_END(segptr)
