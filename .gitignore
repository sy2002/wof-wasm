# The Kickstart ROM: whoever clones the repository places their own copy (tools/rom.py,
# README.md).  The rest of original/ - the disk image, its files and the manual's text - is
# versioned.
original/kick.rom

# build products: everything the build writes under dist/ but the one page, which is the
# repository's runnable game and is rebuilt and committed at every merge
dist/*
!dist/wof.html

# generated at build time from the original executable
src/gen/

# local environment and build products
.venv/
__pycache__/
*.pyc
*.wasm
*.o
*.dylib
.DS_Store

# test runner
.pytest_cache/

# the book's site: built by book/tools/build.py (mkdocs build) and published from there, never
# committed; the game it embeds is copied in from dist/wof.html at every build
book/site/
book/.cache/
